#!/bin/bash

RESOURCES="$(dirname "$0")/../Resources"
VENV="$RESOURCES/.venv"

# First-time setup: create venv with Python 3.11 and install packages
if [ ! -d "$VENV" ]; then
    osascript -e 'display notification "Setting up CSV Tools for the first time. This takes about a minute..." with title "CSV Tools"'
    /usr/local/bin/python3.11 -m venv "$VENV"
    "$VENV/bin/pip" install -q --upgrade pip
    "$VENV/bin/pip" install -q streamlit pandas openpyxl
fi

# Launch the app in a new Terminal window
osascript <<EOF
tell application "Terminal"
    do script "\"$VENV/bin/streamlit\" run \"$RESOURCES/app.py\""
    activate
end tell
EOF
